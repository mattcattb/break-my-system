POSTGRES_DB=break_my_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=15432
REDIS_PORT=26379
WAD_URL=wad://127.0.0.1:27373
WAD_DATA_DIR=/tmp/break-my-system/wads
# Path inside the Minesweeper container's persistent /data volume.
MINESWEEPER_LEADERBOARD_PATH=/data/leaderboard.csv
MINESWEEPER_URL=minesweeper://127.0.0.1:27575
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/break_my_system
REDIS_URL=redis://localhost:26379
PLC_URL=plc://127.0.0.1:27474
TORRENT_CLIENT_IMAGE=mattbou12/go-torrent:0.2.0
TORRENT_TRACKER_IMAGE=mattbou12/go-torrent-tracker:0.2.0
TORRENT_ARTIFACT_DIR=./systems/go-torrent/artifacts/lesson-payload-v1
TORRENT_TRACKER_HOST_PORT=16969
TORRENT_TRACKER_STATUS_HOST_PORT=18080
TORRENT_SEED_STATUS_HOST_PORT=18081
TORRENT_LEARNER_1_STATUS_HOST_PORT=18082
TORRENT_LEARNER_2_STATUS_HOST_PORT=18083
TORRENT_TRACKER_INTERVAL=1s
TORRENT_TRACKER_STATUS_URL=http://127.0.0.1:18080/v1/snapshot
TORRENT_SEED_STATUS_URL=http://127.0.0.1:18081/v1/snapshot
TORRENT_LEARNER_1_STATUS_URL=http://127.0.0.1:18082/v1/snapshot
TORRENT_LEARNER_2_STATUS_URL=http://127.0.0.1:18083/v1/snapshot
BETTER_AUTH_SECRET=dev-secret-change-me-32-characters
BETTER_AUTH_URL=http://localhost:5173
# Optional. Leave both unset for Vite's same-origin API and WebSocket proxy.
# API_PROXY_TARGET=http://localhost:3000
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=ws://localhost:3000

# Optional
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=info
