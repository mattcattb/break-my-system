{
  "name": "break-my-system",
  "private": true,
  "workspaces": [
    "packages/*",
    "systems/minesweeper/clients/typescript",
    "systems/wad-filesystem/clients/typescript"
  ],
  "scripts": {
    "dev": "bun run --filter @break-my-system/minesweeper-client build && bun run --filter @break-my-system/wad-client build && bun run --workspaces --parallel --if-present dev",
    "build": "bun run --workspaces --sequential --if-present build",
    "typecheck": "bun run --workspaces --sequential --if-present typecheck",
    "test": "bun run --workspaces --sequential --if-present test",
    "check": "bun run typecheck && bun run test",
    "systems:up": "docker compose up -d --build",
    "systems:down": "docker compose down"
  },
  "dependencies": {
    "@types/bun": "^1.3.14"
  }
}
